{
	"name": "obsidian-postgresql-mirror",
	"version": "0.1.0",
	"description": "An Obsidian plugin that mirrors the vault into PostgreSQL as tables you can query.",
	"main": "main.js",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc --noEmit && node esbuild.config.mjs production",
		"test": "node --test tests/*.test.ts",
		"lint": "eslint .",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": ["obsidian", "postgresql", "postgis"],
	"license": "MIT",
	"dependencies": {
		"pg": "^8.23.1"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@types/node": "^22.20.5",
		"@types/pg": "^8.15.6",
		"esbuild": "^0.28.2",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.4.0",
		"globals": "^17.6.0",
		"jiti": "^2.6.1",
		"obsidian": "1.14.4",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.59.1"
	}
}
